			(uuid "5581b0a1-8cf6-4257-8bb5-9cf4f147d711")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "BH1750 ADDR pull-down. ROHM's datasheet warns that ADDR/SDA/SCL are not stable unless DVI is held low for >=1us after VCC rises, and in that case prescribes a resistor (approx 100k) on ADDR instead of a direct tie. DVI is hard-tied to SENSOR_3V3 on this board so it rises WITH VCC and no low pulse is possible - and since SENSOR_3V3 is switched by Q3, that power-up sequence now repeats on every measurement cycle rather than once at boot. ADDR still reads low, so the I2C address stays 0x23."
			(at 0 0 0)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "04e42887-003e-4dcf-a180-430bf4798a5d")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
