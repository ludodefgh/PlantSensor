			(hide yes)
			(uuid "14cf6aaf-9f20-4f7e-bd6e-dc9a42b19401")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Note" "Reverse polarity protection: D=BAT_RAW S=VDD_PROT G=GND. Orientation corrected 2026-08-23 (audit #2): a P-FET reverse-battery switch needs Source on the LOAD side so its body diode (anode=Drain) conducts battery->load normally and reverse-biases on a flipped cell. The previous S=BAT_RAW wiring was the load-switch pattern used by Q2/Q3/Q4 (correct for THEM, wrong here) and gave no reverse protection: the body diode stayed forward-biased on reversal, exposing U4 (abs max -0.3V) to about -2.3V. Channel turns on via Vgs once the diode has raised VDD_PROT."
			(at 0 0 270)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "9b124132-006a-4d5a-b56e-9cb15e606f62")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
