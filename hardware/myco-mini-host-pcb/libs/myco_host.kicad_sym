    (property "LCSC Part" "C2653639"
      (id 5) (at 0 -12.70 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Ideal diode (voltage-comparison based, not current-inferred like LM66100): blocks backfeed from breakout J5/Pico-probe 3V3 (tied to VDD_NRF on the breakout, confirmed) into BAT_RAW/CR2032. Turn-off threshold VOUT-VDD=26mV typ (datasheet Principle of Operation: turns MOSFET off when VOUT>VDD). ICA leakage 10nA typ/50nA max @VOUT=4V. Placed in series AFTER Q1 (VDD=Q1 drain side, OUT=VDD_NRF shared net) - Q1 keeps doing reverse-polarity protection (which MAX40203 does NOT provide, abs max -0.3V). EN tied to VDD. See decision log."
      (id 6) (at 0 -15.24 0)
      (effects (font (size 1.27 1.27)) hide)
    )
