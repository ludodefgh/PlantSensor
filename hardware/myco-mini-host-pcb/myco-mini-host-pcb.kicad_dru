(version 1)

# SMD parts only: THT headers (J1/J2) are hand-soldered, not hotplate-reflowed,
# and are structurally required to sit near this edge to mate with the breakout.
# PROBE1 (soil probe) is designed to reach the board edge by intent - excluded too.
(rule "Courtyard to board edge (front, hotplate assembly margin)"
	(layer "F.CrtYd")
	(constraint physical_clearance (min 1mm))
	(condition "B.Layer == 'Edge.Cuts' && A.Reference != 'J1' && A.Reference != 'J2' && A.Reference != 'PROBE1'")
)

(rule "Courtyard to board edge (back, hotplate assembly margin)"
	(layer "B.CrtYd")
	(constraint physical_clearance (min 1mm))
	(condition "B.Layer == 'Edge.Cuts' && A.Reference != 'J1' && A.Reference != 'J2' && A.Reference != 'PROBE1'")
)

(rule "Courtyard to courtyard (hand assembly clearance)"
	(constraint courtyard_clearance (min 0.5mm))
)
