/*
 * NRF54L_breakout — firmware d'auto-test des GPIO exposés (fixture pull-down).
 *
 * Cible officielle la plus proche du module nu (module partagé, pas la carte
 * eval Raytac elle-même) — voir NRF54L_breakout/test-fixture/TEST-FLOW.md
 * pour le protocole complet et NRF54L_breakout/PIN_MAPPING.md pour la table
 * pin module ↔ pin breakout.
 *
 * Pas de capteurs/BLE ici : ce firmware ne fait que balayer les 29 GPIO
 * exposés sur J1/J4 via le shell RTT (commande `selftest`).
 */

/* ── spi00 : flash externe de l'eval board Raytac, absente sur notre
 * breakout — désactivé, comme sur la branche breakout-test. ────────────── */
&spi00 {
	status = "disabled";
};

/* ── uart20 : console/shell par défaut de cette cible. Son pinctrl réclame
 * TX=P1.04, RTS=P1.06, RX=P1.05, CTS=P1.07 — 4 des 29 pins qu'on balaie
 * (J1 pins 12/14/13/15, réseau A). Désactivé pour libérer ces 4 pins en
 * pur GPIO ; logs et shell passent par RTT de toute façon (pas d'UART câblé
 * sur le fixture). Même cause/fix que sur la branche breakout-test. ─────── */
&uart20 {
	status = "disabled";
};
